<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/pucp" android:contentDescription="Logo de la aplicación" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mis sesiones de estudio" android:textSize="28sp" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registra tus horas y conoce cómo distribuyes tu tiempo." android:gravity="center" android:layout_marginBottom="24dp" />
        <Button android:id="@+id/btnAcceder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciar sesión o registrarse" />
        <Button android:id="@+id/btnRecuperar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recuperar contraseña" />
        <TextView android:id="@+id/tvMensaje" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:gravity="center" />
    </LinearLayout>
</ScrollView>